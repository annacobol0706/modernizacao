# Copie este arquivo para .env e troque os valores.
#   Linux/Mac:  cp .env.example .env
#   Windows:    copy .env.example .env
#
# Senha do usuario sa do SQL Server. Regra do SQL Server: minimo 8 caracteres,
# com maiusculas, minusculas, numeros e simbolos.
MSSQL_SA_PASSWORD=

# Senha do usuario "admin" do backoffice. Use apenas caracteres ASCII e nao use aspas.
BACKOFFICE_ADMIN_SENHA=
