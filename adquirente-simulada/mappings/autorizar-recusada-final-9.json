{
  "priority": 8,
  "request": {
    "method": "POST",
    "urlPath": "/adquirente/v1/autorizar",
    "bodyPatterns": [
      { "matchesXPath": { "expression": "//numeroCartao/text()", "matches": ".*9$" } }
    ]
