{
  "priority": 5,
  "request": {
    "method": "POST",
    "urlPath": "/adquirente/v1/autorizar",
    "bodyPatterns": [
      { "matchesXPath": { "expression": "//numeroCartao/text()", "matches": ".*0119$" } }
    ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/xml; charset=UTF-8" },
    "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><respostaAdquirente><codigo>00</codigo><mensagem>Transacao autorizada</mensagem><codigoAutorizacao>{{randomValue length=6 type='NUMERIC'}}</codigoAutorizacao><nsu>{{randomValue length=9 type='NUMERIC'}}</nsu></respostaAdquirente>",
    "transformers": ["response-template"],
    "fixedDelayMilliseconds": 60000
  }
}
